+        let item = AVPlayerItem(url: try #require(URL(string: origin.baseURL + "/media.m3u8")))
+        let output = AVPlayerItemVideoOutput(pixelBufferAttributes: nil)
+        item.add(output)
+        let player = AVPlayer(playerItem: item)
